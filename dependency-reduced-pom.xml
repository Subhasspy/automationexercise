<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>com.automationexercise</groupId>
  <artifactId>automationexercise</artifactId>
  <name>Automation Exercise - Selenium Cucumber TestNG</name>
  <version>1.0.0</version>
  <description>Enterprise-grade test automation framework using Selenium, Cucumber BDD, and TestNG with Allure Reporting</description>
  <build>
    <sourceDirectory>src/main/java</sourceDirectory>
    <testSourceDirectory>src/test/java</testSourceDirectory>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
    </resources>
    <testResources>
      <testResource>
        <directory>src/test/resources</directory>
      </testResource>
    </testResources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>${maven.compiler.plugin.version}</version>
        <configuration>
          <source>${maven.compiler.source}</source>
          <target>${maven.compiler.target}</target>
          <release>${maven.compiler.target}</release>
          <encoding>${project.build.sourceEncoding}</encoding>
          <compilerArgs>
            <arg>-parameters</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>${maven.surefire.plugin.version}</version>
        <configuration>
          <suiteXmlFiles>
            <suiteXmlFile>testng.xml</suiteXmlFile>
          </suiteXmlFiles>
          <parallel>methods</parallel>
          <threadCount>2</threadCount>
          <argLine>-XX:+EnablePreview</argLine>
          <systemPropertyVariables>
            <listener>io.qameta.allure.testng.AllureTestNg</listener>
          </systemPropertyVariables>
          <reportFormat>plain</reportFormat>
          <reportFormat>xml</reportFormat>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <version>${maven.failsafe.plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <parallel>methods</parallel>
          <threadCount>2</threadCount>
          <systemPropertyVariables>
            <listener>io.qameta.allure.testng.AllureTestNg</listener>
          </systemPropertyVariables>
          <argLine>-XX:+EnablePreview</argLine>
          <reportFormat>plain</reportFormat>
          <reportFormat>xml</reportFormat>
        </configuration>
      </plugin>
      <plugin>
        <groupId>io.qameta.allure</groupId>
        <artifactId>allure-maven</artifactId>
        <version>${allure.maven.plugin.version}</version>
        <configuration>
          <reportVersion>${allure.version}</reportVersion>
          <resultsDirectory>target/allure-results</resultsDirectory>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>${maven.shade.plugin.version}</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>${maven.jar.plugin.version}</version>
        <configuration>
          <archive>
            <manifest>
              <addClasspath>true</addClasspath>
              <classpathPrefix>lib/</classpathPrefix>
              <mainClass>com.automationexercise.App</mainClass>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-assembly-plugin</artifactId>
        <version>${maven.assembly.plugin.version}</version>
        <configuration>
          <descriptorRefs>
            <descriptorRef>jar-with-dependencies</descriptorRef>
          </descriptorRefs>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.cucumber</groupId>
        <artifactId>messages</artifactId>
        <version>${cucumber.messages.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
  <properties>
    <rest.assured.version>5.4.0</rest.assured.version>
    <maven.shade.plugin.version>3.5.1</maven.shade.plugin.version>
    <testng.version>7.12.0</testng.version>
    <slf4j.version>2.0.13</slf4j.version>
    <log4j.version>2.23.1</log4j.version>
    <cucumber.messages.version>24.1.0</cucumber.messages.version>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.jar.plugin.version>3.4.1</maven.jar.plugin.version>
    <picocontainer.version>2.15</picocontainer.version>
    <cucumber.version>7.18.0</cucumber.version>
    <maven.surefire.plugin.version>3.2.5</maven.surefire.plugin.version>
    <selenium.version>4.25.0</selenium.version>
    <gson.version>2.11.0</gson.version>
    <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <commons.lang3.version>3.18.0</commons.lang3.version>
    <allure.maven.plugin.version>2.14.0</allure.maven.plugin.version>
    <maven.failsafe.plugin.version>3.2.5</maven.failsafe.plugin.version>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <maven.assembly.plugin.version>3.7.1</maven.assembly.plugin.version>
    <maven.compiler.target>21</maven.compiler.target>
    <allure.version>2.25.0</allure.version>
    <commons.configuration.version>2.10.1</commons.configuration.version>
  </properties>
</project>
